<!-- Dejavu Test's launcher icon (-PdejavuTest in build.gradle): Dejavu's icon with a dark band across its lower half,
     so the test version is told apart from Dejavu at a glance. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/dejavu_test_launcher_background" />
    <foreground android:drawable="@drawable/dejavu_launcher_foreground" />
    <monochrome android:drawable="@drawable/dejavu_launcher_monochrome" />
</adaptive-icon>
